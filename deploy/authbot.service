[Unit]
Description=Private Discord Authenticator Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=authbot
Group=authbot
WorkingDirectory=/opt/authbot
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/authbot/.venv/bin/python -m authbot run
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/authbot/data

[Install]
WantedBy=multi-user.target
