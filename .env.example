# Prefer: python -m authbot setup (generates the encryption key without printing it)
DISCORD_TOKEN=
ALLOWED_USER_IDS=
ENCRYPTION_KEY=
DATA_DIR=./data
# Optional: register /auth instantly in one server; empty = global command
DISCORD_GUILD_ID=
# Optional HTTP proxy for both Discord REST and Gateway; empty = direct
DISCORD_PROXY=
# Discord forms send the seed through Discord. Local CLI import is always available.
ALLOW_DISCORD_IMPORT=false
